# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Database > Connect > Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kiet-portal?retryWrites=true&w=majority

# Signs login tokens. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server will not start without it (and needs at least 32 characters in production).
JWT_SECRET=
# How long a login lasts
JWT_EXPIRE=7d

PORT=5000
NODE_ENV=development

# Frontend origins allowed to call the API from a browser, comma separated, no trailing slash.
# Empty in development allows http://localhost:5173.
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional. Proxies to trust for the client IP (used by the login rate limit).
# Default "loopback" fits nginx on the same server.
# TRUST_PROXY=loopback

# Optional, seed script only: fixed passwords per role instead of random ones (min 10 characters).
# SEED_PASSWORD_STUDENT=
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_FACULTY=
# SEED_PASSWORD_HOD=
# SEED_PASSWORD_CTPO=

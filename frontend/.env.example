# Backend base URL (the /api prefix is added by the client)
VITE_API_URL=http://localhost:5000
# false = real API and MongoDB (production); true = every module uses local mock data, no backend needed.
# Preview pages (timetable, fees, bus pass, …) have no endpoints yet and use sample data either way.
VITE_USE_MOCK=false
# Only with VITE_USE_MOCK=true: modules listed here use the real API anyway (comma separated),
# e.g. auth (sign-in, registration) and resume (uploads, builder draft, history).
# VITE_REAL_MODULES=auth,resume

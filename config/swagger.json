{
  "openapi": "3.0.0",
  "info": {
    "title": "Student Management System API",
    "version": "1.0.0",
    "description": "Interactive Swagger UI documentation for all endpoints of the Student Management System backend."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from /api/auth/login"
      }
    }
  },
  "tags": [
    { "name": "System Health", "description": "Uptime and status check" },
    { "name": "Authentication", "description": "Login, register, and profile access" },
    { "name": "Departments", "description": "Academic department records" },
    { "name": "Students", "description": "Student profiles, achievements, and certs" },
    { "name": "Faculty", "description": "Faculty staff directory" },
    { "name": "Activities", "description": "Student extracurricular and technical activities" },
    { "name": "Verification", "description": "Faculty approval & point allocation workflow" },
    { "name": "Analytics & Reports", "description": "Dashboard metrics and generated student reports" },
    { "name": "Notifications", "description": "In-app alerts and notifications" },
    { "name": "Events", "description": "College events and year-based notifications" },
    { "name": "Certifications", "description": "Student certifications and verification workflows" },
    { "name": "Internships & Achievements", "description": "Student internships and academic achievements" },
    { "name": "Head of Department (HOD)", "description": "HOD scoped dashboard, students, reports, and CTPO approvals" },
    { "name": "Class Teacher & Placement Officer (CTPO)", "description": "CTPO scoped class section dashboard and student tracking" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System Health"],
        "summary": "Root welcome endpoint",
        "responses": {
          "200": { "description": "API status and docs link" }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["System Health"],
        "summary": "Service uptime health check",
        "responses": {
          "200": { "description": "Service is UP" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Authenticate user & get JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "alice@student.edu" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Successful login with JWT token" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Ravi Kumar" },
                  "email": { "type": "string", "example": "ravi@college.edu" },
                  "password": { "type": "string", "example": "password123" },
                  "role": { "type": "string", "enum": ["student", "faculty", "admin"], "example": "faculty" },
                  "department": { "type": "string", "example": "CSE", "description": "Required for faculty" },
                  "year": { "type": "string", "example": "3rd Year", "description": "Required for faculty" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully (Faculty registered with pending status)" },
          "400": { "description": "Missing fields, department/year missing for faculty, or user exists" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get profile of logged-in user",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile data" },
          "401": { "description": "Not authorized" }
        }
      }
    },
    "/api/departments": {
      "get": {
        "tags": ["Departments"],
        "summary": "List all departments",
        "responses": {
          "200": { "description": "Array of departments" }
        }
      }
    },
    "/api/departments/{id}": {
      "get": {
        "tags": ["Departments"],
        "summary": "Get department details by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "dept_cse_1" } }
        ],
        "responses": {
          "200": { "description": "Department detail" }
        }
      }
    },
    "/api/students": {
      "get": {
        "tags": ["Students"],
        "summary": "List all students (Faculty or Admin only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of student profiles" }
        }
      }
    },
    "/api/students/dashboard": {
      "get": {
        "tags": ["Students"],
        "summary": "Consolidated Student Dashboard (Student only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Complete consolidated dashboard data" }
        }
      }
    },
    "/api/students/profile": {
      "get": {
        "tags": ["Students"],
        "summary": "Get logged-in student profile (Student only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Student profile data" }
        }
      },
      "put": {
        "tags": ["Students"],
        "summary": "Update logged-in student profile (Student only)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phoneNumber": { "type": "string", "example": "+1-555-0199" },
                  "city": { "type": "string", "example": "Kakinada" },
                  "area": { "type": "string", "example": "Sarpavaram" },
                  "latitude": { "type": "number", "example": 16.9891 },
                  "longitude": { "type": "number", "example": 82.2475 },
                  "linkedinUrl": { "type": "string", "example": "https://linkedin.com/in/alice-johnson" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated student profile" }
        }
      }
    },
    "/api/students/academic": {
      "get": {
        "tags": ["Students"],
        "summary": "Get academic details (Student only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Academic information" }
        }
      }
    },
    "/api/students/attendance": {
      "get": {
        "tags": ["Students"],
        "summary": "Get attendance report with calendar (Student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "month", "in": "query", "schema": { "type": "string", "example": "September" } },
          { "name": "year", "in": "query", "schema": { "type": "string", "example": "2026" } }
        ],
        "responses": {
          "200": { "description": "Attendance report with calendar and subject percentages" }
        }
      }
    },
    "/api/students/academic-report": {
      "get": {
        "tags": ["Students"],
        "summary": "Get academic report with semester grades and credits (Student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "semester", "in": "query", "schema": { "type": "integer", "example": 6 } }
        ],
        "responses": {
          "200": { "description": "Academic report with subjects, grades, SGPA, and CGPA" }
        }
      }
    },
    "/api/students/nearby-activities": {
      "get": {
        "tags": ["Students"],
        "summary": "Get nearby activities matching location and department/year (Student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "radius", "in": "query", "schema": { "type": "number", "example": 10 } }
        ],
        "responses": {
          "200": { "description": "Filtered list of nearby events and activities" }
        }
      }
    },
    "/api/students/{id}": {
      "get": {
        "tags": ["Students"],
        "summary": "Get student by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "Student profile" }
        }
      },
      "delete": {
        "tags": ["Students"],
        "summary": "Delete student profile (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "Student profile deleted successfully" },
          "403": { "description": "Forbidden - Admin only" },
          "404": { "description": "Student not found" }
        }
      }
    },
    "/api/students/{id}/achievements": {
      "get": {
        "tags": ["Students"],
        "summary": "Get student achievements",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "List of achievements" }
        }
      }
    },
    "/api/students/{id}/internships": {
      "get": {
        "tags": ["Students"],
        "summary": "Get student internships",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "List of internships" }
        }
      }
    },
    "/api/students/{id}/certifications": {
      "get": {
        "tags": ["Students"],
        "summary": "Get student certifications",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "List of certifications" }
        }
      }
    },
    "/api/faculty": {
      "get": {
        "tags": ["Faculty"],
        "summary": "List faculty directory",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of faculty" }
        }
      }
    },
    "/api/faculty/{id}": {
      "get": {
        "tags": ["Faculty"],
        "summary": "Get faculty by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "faculty_1" } }
        ],
        "responses": {
          "200": { "description": "Faculty profile" }
        }
      }
    },
    "/api/activities": {
      "get": {
        "tags": ["Activities"],
        "summary": "Get activities (Student views own; Faculty/Admin views all)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Activities list" }
        }
      },
      "post": {
        "tags": ["Activities"],
        "summary": "Submit a new student activity",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "category", "activityDate"],
                "properties": {
                  "title": { "type": "string", "example": "National Robotics Championship 2026" },
                  "category": { "type": "string", "example": "cat_hackathon" },
                  "description": { "type": "string", "example": "Built autonomous navigation robot" },
                  "activityDate": { "type": "string", "format": "date", "example": "2026-03-01" },
                  "pointsRequested": { "type": "number", "example": 20 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Activity created" }
        }
      }
    },
    "/api/activities/{id}": {
      "get": {
        "tags": ["Activities"],
        "summary": "Get single activity by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "example": "act_1" } }
        ],
        "responses": {
          "200": { "description": "Activity detail with evidence files" }
        }
      }
    },
    "/api/verification/{activityId}": {
      "post": {
        "tags": ["Verification"],
        "summary": "Faculty verify or approve an activity",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "activityId", "in": "path", "required": true, "schema": { "type": "string", "example": "act_2" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["approved", "rejected", "requested_changes"], "example": "approved" },
                  "pointsGranted": { "type": "number", "example": 25 },
                  "remarks": { "type": "string", "example": "Certificate credentials verified and approved." }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Verification recorded successfully" }
        }
      }
    },
    "/api/analytics/dashboard": {
      "get": {
        "tags": ["Analytics & Reports"],
        "summary": "Get dashboard KPI counts",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "KPI metrics" }
        }
      }
    },
    "/api/analytics/departments": {
      "get": {
        "tags": ["Analytics & Reports"],
        "summary": "Get department-wise activity analytics (Faculty or Admin only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Department analytics breakdown" }
        }
      }
    },
    "/api/reports/student/{studentId}": {
      "get": {
        "tags": ["Analytics & Reports"],
        "summary": "Generate comprehensive student report",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "studentId", "in": "path", "required": true, "schema": { "type": "string", "example": "student_1" } }
        ],
        "responses": {
          "200": { "description": "Student full academic and activity report" }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Get user notifications",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of user alerts" }
        }
      }
    },
    "/api/notifications/read-all": {
      "put": {
        "tags": ["Notifications"],
        "summary": "Mark all notifications as read",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "All marked as read" }
        }
      }
    },
    "/api/notifications/unread": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Get unread notifications for logged-in user",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of unread notifications" }
        }
      }
    },
    "/api/notifications/{id}/read": {
      "put": {
        "tags": ["Notifications"],
        "summary": "Mark a single notification as read",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Notification marked as read" },
          "404": { "description": "Notification not found" }
        }
      }
    },
    "/api/notifications/{id}": {
      "delete": {
        "tags": ["Notifications"],
        "summary": "Delete a notification belonging to user",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Notification deleted successfully" },
          "404": { "description": "Notification not found" }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": ["Events"],
        "summary": "Get college events (filtered by audience scope & user role)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "targetType", "in": "query", "required": false, "schema": { "type": "string", "enum": ["specific_year", "all_years"] } },
          { "name": "targetYear", "in": "query", "required": false, "schema": { "type": "string", "example": "3rd Year" } }
        ],
        "responses": {
          "200": { "description": "List of visible events" }
        }
      },
      "post": {
        "tags": ["Events"],
        "summary": "Create new event with audience targeting and automated notifications (Admin/Faculty)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "date", "targetType"],
                "properties": {
                  "title": { "type": "string", "example": "Python Workshop" },
                  "description": { "type": "string", "example": "Hands-on Python training" },
                  "date": { "type": "string", "format": "date", "example": "2026-09-15" },
                  "time": { "type": "string", "example": "10:00 AM" },
                  "venue": { "type": "string", "example": "Seminar Hall A" },
                  "targetType": { "type": "string", "enum": ["specific_year", "all_years"], "example": "specific_year" },
                  "targetYear": { "type": "string", "example": "3rd Year" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Event created and notifications dispatched" },
          "400": { "description": "Validation error" },
          "403": { "description": "Unauthorized" }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "tags": ["Events"],
        "summary": "Get single event by ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event details" },
          "404": { "description": "Event not found" }
        }
      },
      "put": {
        "tags": ["Events"],
        "summary": "Update event details (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event updated successfully" },
          "404": { "description": "Event not found" }
        }
      },
      "delete": {
        "tags": ["Events"],
        "summary": "Delete event (Admin only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Event deleted successfully" },
          "404": { "description": "Event not found" }
        }
      }
    },
    "/api/certifications": {
      "get": {
        "tags": ["Certifications"],
        "summary": "Get student certifications (Returns logged-in student's own records)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of student certifications" }
        }
      },
      "post": {
        "tags": ["Certifications"],
        "summary": "Add certification to portfolio (Student only - saved directly, no faculty approval)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "issuingOrganization"],
                "properties": {
                  "title": { "type": "string", "example": "Python Programming Certification" },
                  "issuingOrganization": { "type": "string", "example": "Infosys Springboard" },
                  "platform": { "type": "string", "example": "Infosys Springboard" },
                  "issueDate": { "type": "string", "format": "date", "example": "2026-08-20" },
                  "credentialId": { "type": "string", "example": "PY12345" },
                  "credentialUrl": { "type": "string", "example": "https://example.com/certificate/PY12345" },
                  "certificateFileUrl": { "type": "string", "example": "/uploads/certificates/python-certificate.png" },
                  "description": { "type": "string", "example": "Python programming certification" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Certification added successfully" },
          "400": { "description": "Invalid input or invalid credential URL" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Student only" }
        }
      }
    },
    "/api/certifications/{id}": {
      "get": {
        "tags": ["Certifications"],
        "summary": "Get certification by ID (Ownership protected)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Certification details" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Not owner" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "tags": ["Certifications"],
        "summary": "Update certification details (Owner student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "example": "Python Programming Certification" },
                  "issuingOrganization": { "type": "string", "example": "Infosys Springboard" },
                  "credentialId": { "type": "string", "example": "PY12345" },
                  "credentialUrl": { "type": "string", "example": "https://example.com/certificate/PY12345" },
                  "certificateFileUrl": { "type": "string", "example": "/uploads/certificates/python-certificate.png" },
                  "description": { "type": "string", "example": "Updated description" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Certification updated successfully" },
          "400": { "description": "Invalid input or invalid credential URL" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Not owner" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Certifications"],
        "summary": "Delete certification (Owner student only)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Certification deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Not owner" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/internships": {
      "get": {
        "tags": ["Internships & Achievements"],
        "summary": "Get internships",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "List of internships" }
        }
      },
      "post": {
        "tags": ["Internships & Achievements"],
        "summary": "Create internship (Student only)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": { "description": "Internship created" }
        }
      }
    },
    "/api/internships/{id}": {
      "delete": {
        "tags": ["Internships & Achievements"],
        "summary": "Delete internship (Owner student or Admin)",

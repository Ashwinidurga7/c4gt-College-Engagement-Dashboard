# Backend base URL (the /api prefix is added by the client)
VITE_API_URL=http://localhost:5000
# true = every module uses local mock data; false = real API (mock-only modules stay mocked)
VITE_USE_MOCK=true
# With VITE_USE_MOCK=true, modules listed here use the real API anyway (comma separated).
# Ready today: auth (sign-in, registration) and resume (uploads, builder draft, history).
# With real sign-in, the modules still on mock data show the demo data of the signed-in user's role.
# VITE_REAL_MODULES=auth,resume
